# ============================================================
# PATHS
# ============================================================

static func get_root_path() -> String:
	return ProjectSettings.get_setting(ROOT_PATH_SETTING, DEFAULT_ROOT_PATH)

static func get_languages_dir() -> String:
	return "%s/%s" % [get_root_path(), LANGUAGES_DIR_NAME]

static func get_registry_filename() -> String:
	return ProjectSettings.get_setting(REGISTRY_FILENAME_SETTING, DEFAULT_REGISTRY_FILENAME)

static func get_registry_path() -> String:
	return "%s/%s" % [get_root_path(), get_registry_filename()]

# ============================================================
# HELPERS
# ============================================================

static func to_snake_case(text: String) -> String:
	var regex := RegEx.new()
	regex.compile("[^a-zA-Z0-9]+")
	var result: String = regex.sub(text.strip_edges(), "_", true)
	return result.to_lower()

## Looks up a language dict by code. Returns {} if not found.
static func find_language(code: String) -> Dictionary:
	for lang in LANGUAGES:
		if lang.get("code", "") == code:
			return lang
	return {}

## Looks up a script dict by code. Returns {} if not found.
static func find_script(code: String) -> Dictionary:
	for scr in SCRIPTS:
		if scr.get("code", "") == code:
			return scr
	return {}

## Looks up a region dict by code. Returns {} if not found.
static func find_region(code: String) -> Dictionary:
	for reg in REGIONS:
		if reg.get("code", "") == code:
			return reg
	return {}

## Returns all regions whose "code" is a valid country code.
static func get_all_regions() -> Array[Dictionary]:
	return REGIONS.duplicate()

## Returns all regions whose "code" is a valid country code and which
## are not already used by the given language.
static func get_regions_for_language(lang_code: String) -> Array[Dictionary]:
	# Since the new REGIONS list is not language-specific, we return
	# all regions. The caller (LanguageDialog) is responsible for
	# filtering out already-existing ones.
	return REGIONS.duplicate()

## Composes a locale code like "en_US" from a language + region code.
## If `script_code` is provided, the locale becomes "en_Latn_US".
static func compose_locale(language_code: String, region_code: String, script_code: String = "") -> String:
	var parts: Array[String] = [language_code]
	if not script_code.is_empty():
		parts.append(script_code)
	if not region_code.is_empty():
		parts.append(region_code)
	return "_".join(parts)